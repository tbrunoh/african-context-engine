{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ace:context-pack:1.0",
  "title": "ACE context pack",
  "description": "Structural schema for editors and tools. The ace packs validate command adds the trust rules, such as source requirements per review status.",
  "type": "object",
  "required": ["spec_version", "id", "title", "license", "maintainers", "facts"],
  "properties": {
    "spec_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "order": { "type": "integer" },
    "labels": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 40 } },
    "license": { "type": "string" },
    "tier": { "enum": ["open", "verified"], "default": "open" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "language": { "type": "string" },
    "maintainers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" }, "minItems": 1 }
  },
  "if": { "properties": { "tier": { "const": "open" } } },
  "then": { "properties": { "license": { "const": "CC-BY-4.0" } } },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["id", "claim", "topic", "vertical", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "claim": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "maxLength": 160 },
        "topic": { "type": "string" },
        "vertical": { "enum": ["agriculture", "health", "finance", "safety", "legal", "education", "climate"] },
        "kind": { "enum": ["action", "sign", "info"], "default": "info" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "months": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "language": { "type": "string" },
        "scope": { "$ref": "#/$defs/scope" },
        "translations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["claim"],
            "properties": {
              "claim": { "type": "string" },
              "short": { "type": "string", "maxLength": 160 },
              "reviewed": { "type": "boolean", "default": false }
            }
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number"],
            "properties": {
              "label": { "type": "string" },
              "number": { "type": "string", "pattern": "^\\+?[0-9]{3,15}$" },
              "queues": { "type": "array", "items": { "type": "string" } },
              "free": { "type": "boolean" },
              "hours": { "type": "string" }
            }
          }
        },
        "source": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "checked_on": { "type": "string", "format": "date" },
        "reviewed_by": { "type": "string" },
        "review_status": { "enum": ["draft", "sourced", "expert_reviewed", "outcome_verified"], "default": "draft" },
        "expires": { "type": "string", "format": "date" },
        "safety_critical": { "type": "boolean", "default": false }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "countries": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
        "admin_areas": { "type": "array", "items": { "type": "string" } },
        "center": {
          "type": "object", "required": ["lat", "lon"],
          "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } }
        },
        "radius_km": { "type": "number", "exclusiveMinimum": 0 },
        "altitude_min_m": { "type": "number" },
        "altitude_max_m": { "type": "number" }
      }
    }
  }
}
